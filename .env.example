# --- Database ---
DATABASE_URL=postgresql+asyncpg://fpl:fpl@postgres:5432/fpl
SYNC_DATABASE_URL=postgresql+psycopg2://fpl:fpl@postgres:5432/fpl   # used by Alembic

# --- Cache / broker ---
REDIS_URL=redis://redis:6379/0

# --- External data sources ---
FPL_BASE_URL=https://fantasy.premierleague.com/api
UNDERSTAT_BASE_URL=https://understat.com

# --- ML ---
MODEL_DIR=/app/models
MODEL_TIME_LIMIT_SECONDS=600

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development

DEFAULT_MANAGER_ID=ID
